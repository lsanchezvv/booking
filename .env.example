# Copy to .env. Never commit real values.

# Booking API (apps/api) and tests. Local values come from `pnpm exec supabase status`.
SUPABASE_URL="http://127.0.0.1:55321"
SUPABASE_SERVICE_ROLE_KEY=""

# Only for `pnpm db:migrate:remote` against the shared hosted project
# (session pooler, port 5432).
# BOOKING_DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
